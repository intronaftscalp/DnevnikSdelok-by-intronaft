<Window x:Class="DnevnikSdelok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DnevnikSdelok"
        Title="DnevnikSdelok — Мои сделки"
        Height="920" Width="1500" MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        ResizeMode="CanResize"
        Background="#000000" Foreground="#00FF41"
        Loaded="WindowLoaded" Closing="WindowClosing" PreviewKeyDown="WindowPreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="18,12,18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border x:Name="HeaderBand" Grid.Row="0" Margin="0,0,0,12"
                Background="#030A04" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="DnevnikSdelok" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock Text="Мои сделки · Binance через Vataga"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer x:Name="DashboardScrollViewer" Grid.Row="1" Background="#000000"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="DashboardWidgets" AllowDrop="True"
                       Drop="DashboardDrop" DragOver="DashboardDragOver"/>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Данные хранятся локально на этом компьютере."
                       Foreground="{DynamicResource MutedBrush}" FontSize="11"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <Button x:Name="RemoveConnectionButton" Grid.Column="1" Content="Удалить выбранное подключение"
                    Padding="10,5" FontSize="11" Margin="0,0,8,0" Visibility="Collapsed"
                    Click="RemoveConnectionClick"/>
            <Button Content="⚙  Настройки" Grid.Column="2" Padding="10,5"
                    FontSize="11" Click="SettingsClick"/>
        </Grid>
    </Grid>
</Window>
