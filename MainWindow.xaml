<Window x:Class="DnevnikSdelok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DnevnikSdelok"
        Title="DnevnikSdelok"
        Height="920" Width="1500" MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        ResizeMode="CanResize"
        Background="#000000" Foreground="#00FF41"
        Loaded="WindowLoaded" Closing="WindowClosing" PreviewKeyDown="WindowPreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <TabControl x:Name="MainTabs" Background="#000000" Foreground="#00FF41">
        <TabItem Header="Мои сделки">
            <Grid x:Name="TradesPage" Margin="14"/>
        </TabItem>
        <TabItem Header="Заметки">
            <Grid Margin="14">
                <DataGrid x:Name="NotesGrid" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False"
                          SelectionUnit="FullRow" SelectionMode="Single"
                          MouseDoubleClick="NotesGridMouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата и время" Binding="{Binding EntryDisplay}" Width="210"/>
                        <DataGridTextColumn Header="Тикер" Binding="{Binding Symbol}" Width="130"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="140"/>
                        <DataGridTextColumn Header="Причина входа" Binding="{Binding EntryReason}" Width="220"/>
                        <DataGridTextColumn Header="Заметка" Binding="{Binding JournalDescription}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
        <TabItem Header="Сводка">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="DashboardScrollViewer" Grid.Row="0" Background="#000000"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="DashboardWidgets" AllowDrop="True"
                               Drop="DashboardDrop" DragOver="DashboardDragOver"/>
                </ScrollViewer>
                <TextBlock x:Name="StatusText" Grid.Row="1" Margin="4,8"
                           Text="Данные хранятся локально на этом компьютере."
                           Foreground="{DynamicResource MutedBrush}" FontSize="11"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
