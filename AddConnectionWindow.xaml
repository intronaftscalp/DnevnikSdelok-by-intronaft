<Window x:Class="DnevnikSdelok.AddConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подключить Binance через Vataga"
        Width="520" Height="600"
        MinWidth="460" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#000000"
        Foreground="#00FF41">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,6,0,14"/>
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,6,0,14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,6,0,14"/>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#101812"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Новое подключение" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="Vataga → Binance · только чтение" Foreground="#9AA8B5" Margin="0,7,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,25,0,0">
            <TextBlock Text="Название аккаунта" Foreground="#B8C2CC"/>
            <TextBox x:Name="AccountNameBox" Text="Vataga Binance"/>

            <TextBlock Text="Рынок" Foreground="#B8C2CC"/>
            <ComboBox x:Name="MarketBox" SelectedIndex="0">
                <ComboBoxItem Content="Спот" Tag="spot"/>
                <ComboBoxItem Content="Фьючерсы USDT-M" Tag="futures"/>
            </ComboBox>

            <TextBlock Text="Публичный API-ключ" Foreground="#B8C2CC"/>
            <TextBox x:Name="ApiKeyBox" TextChanged="InputChanged"/>

            <TextBlock Text="Секретный API-ключ" Foreground="#B8C2CC"/>
            <PasswordBox x:Name="ApiSecretBox" PasswordChanged="InputChanged"/>

            <Border Background="#1B252E" CornerRadius="7" Padding="12" Margin="0,0,0,12">
                <TextBlock TextWrapping="Wrap" Foreground="#B7C4CE" LineHeight="21">
                    Ключи создавайте в личном кабинете Vataga. Оставьте для них только доступ на чтение — торговля и вывод средств программе не нужны. Ключи будут зашифрованы Windows для этого пользователя и не отправляются куда-либо, кроме официального API Binance.
                </TextBlock>
            </Border>
            <TextBlock x:Name="StatusText" Foreground="#9AA8B5" TextWrapping="Wrap" MinHeight="42"/>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Отмена" Grid.Column="1" Margin="0,0,10,0"
                    Background="{DynamicResource ControlBrush}"
                    Foreground="{DynamicResource ForegroundBrush}" Click="CancelClick"/>
            <Button x:Name="ConnectButton" Content="Проверить и сохранить"
                    Grid.Column="2" IsEnabled="False" Click="ConnectClick"/>
        </Grid>
    </Grid>
</Window>
